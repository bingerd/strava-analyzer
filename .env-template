# =============================================================================
# Strava Analyzer Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For local development, use http://localhost:8080 URLs.
# For production (Cloud Run), use your domain (e.g., https://strava.bngrd.com).

# -----------------------------------------------------------------------------
# Strava API credentials (get from https://www.strava.com/settings/api)
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Random string for webhook verification (you choose this)
STRAVA_VERIFY_TOKEN=your_random_verify_token

# OAuth redirect URI (must match what's registered in Strava API settings)
# For local development: http://localhost:8080/auth/callback
# For production: https://your-domain.com/auth/callback
STRAVA_REDIRECT_URI=http://localhost:8080/auth/callback

# -----------------------------------------------------------------------------
# GCP Configuration
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name

# For local development, set path to your service account key JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# -----------------------------------------------------------------------------
# Authentication (required for API access)
# -----------------------------------------------------------------------------
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET_KEY=your_random_32_char_secret_key

# Admin credentials
# To generate password hash:
# 1. Start the app WITHOUT these variables set
# 2. Call: curl -X POST "http://localhost:8080/api/hash-password?password=yourpassword"
# 3. Copy the hash into ADMIN_PASSWORD_HASH
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$your_bcrypt_hash_here

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Legacy/Deprecated (not needed for multi-user setup)
# -----------------------------------------------------------------------------
# ACCESS_TOKEN=
# REFRESH_TOKEN=
